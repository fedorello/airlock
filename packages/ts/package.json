{
  "name": "airlock",
  "version": "0.1.0",
  "description": "A human-approval gate for the dangerous things an AI agent does.",
  "license": "MIT",
  "author": "Fedor Chishchin",
  "homepage": "https://github.com/fedorello/airlock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedorello/airlock.git",
    "directory": "packages/ts"
  },
  "bugs": {
    "url": "https://github.com/fedorello/airlock/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "human-in-the-loop",
    "approval",
    "tool-use",
    "guardrails",
    "anthropic",
    "openai"
  ],
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "demo": "tsx examples/support-agent/in-memory-demo.ts",
    "demo:redis": "tsx examples/support-agent/redis-demo.ts"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
